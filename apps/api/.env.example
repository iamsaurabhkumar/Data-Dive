# ── Mode ─────────────────────────────────────────────────────────────
# true  → deterministic mock data, no DB/Redis/credentials needed
# false → Supabase Postgres + real JWT verification
MOCK_MODE=true
DEBUG=false

# ── Supabase (required when MOCK_MODE=false) ─────────────────────────
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_JWT_SECRET=          # Project settings → API → JWT secret (HS256)
DATABASE_URL=                 # postgresql+asyncpg://postgres:...@db.xxx.supabase.co:5432/postgres

# ── Platform OAuth apps ──────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
META_APP_ID=
META_APP_SECRET=

# ── Infra ────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
FRONTEND_URL=http://localhost:3000

# ── Analytics ────────────────────────────────────────────────────────
CREATOR_TIMEZONE=UTC          # IANA tz used for posting-time patterns, e.g. Europe/Berlin
MOCK_SEED=42

# ── Generate Next Project ───────────────────────────────────────────
AI_ENRICHMENT_ENABLED=true    # queue an LLM polish pass (worker needs OPENAI_API_KEY)

# ── Usage tracking / telemetry (docs/USAGE_TRACKING.md) ──────────────
TELEMETRY_ENABLED=true
TELEMETRY_SINKS=db,log        # db | log | webhook | otlp (comma-separated)
TELEMETRY_HASH_SALT=change-me # salts creator ids in exported payloads
TELEMETRY_WEBHOOK_URL=        # e.g. https://collector.example.com/ingest
TELEMETRY_WEBHOOK_TOKEN=
TELEMETRY_OTLP_ENDPOINT=      # e.g. http://otel-collector:4318/v1/logs
TELEMETRY_OTLP_HEADERS=       # key=value,key2=value2
ADMIN_USER_IDS=               # Supabase user ids allowed to read /api/telemetry/summary?scope=all

# ── Feedback surveys ─────────────────────────────────────────────────
FEEDBACK_MIN_USES=3           # ask only after a feature was used this many times
FEEDBACK_COOLDOWN_DAYS=30     # don't re-ask about a feature within this window
FEEDBACK_DISMISS_COOLDOWN_DAYS=7
FEEDBACK_MAX_PROMPTS_PER_DAY=1
